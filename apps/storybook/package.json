{
  "name": "@repo/storybook",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "predev": "node ./scripts/ensure-storybook-public.mjs",
    "dev": "node ./scripts/dev.mjs",
    "dev:next": "next dev --experimental-https --port 6006",
    "dev:stories": "storybook dev -p 6007 --no-open",
    "build:storybook": "node ./scripts/build-storybook.mjs",
    "build": "pnpm run build:storybook && next build",
    "start": "next start --port 6006",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@repo/ui": "workspace:*",
    "next": "^16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@storybook/addon-docs": "^10.5.3",
    "@storybook/addon-links": "^10.5.3",
    "@storybook/nextjs-vite": "^10.5.3",
    "@storybook/react": "^10.5.3",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^26",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "date-fns": "^4.4.0",
    "eslint": "^9.29.0",
    "lucide-react": "^1.25.0",
    "react-hook-form": "^7.82.0",
    "recharts": "3.8.0",
    "sonner": "^2.0.7",
    "storybook": "^10.5.3",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "zod": "^4.4.3"
  }
}
