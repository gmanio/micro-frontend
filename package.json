{
  "name": "micro-frontend",
  "private": true,
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "scripts": {
    "dev": "NODE_EXTRA_CA_CERTS=\"$(mkcert -CAROOT)/rootCA.pem\" turbo run dev --filter=@repo/home --filter=@repo/passport --filter=@repo/storybook",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "dev:stories": "pnpm --filter @repo/storybook dev:stories",
    "dev:docs": "pnpm --filter @repo/docs dev"
  },
  "devDependencies": {
    "turbo": "^2.10.6",
    "typescript": "^7.0.2"
  }
}
