{
  "name": "micro-frontend",
  "private": true,
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "scripts": {
    "dev": "NODE_EXTRA_CA_CERTS=\"$(mkcert -CAROOT)/rootCA.pem\" turbo run dev --filter=@repo/home --filter=@repo/passport --filter=@repo/storybook",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "dev:stories": "pnpm --filter @repo/storybook dev:stories",
    "dev:docs": "pnpm --filter @repo/docs dev"
  },
  "devDependencies": {
    "turbo": "^2.10.6",
    "typescript": "~5.9.3"
  }
}
