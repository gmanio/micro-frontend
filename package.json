{
  "name": "micro-frontend",
  "private": true,
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
  "scripts": {
    "dev": "NODE_EXTRA_CA_CERTS=\"$(mkcert -CAROOT)/rootCA.pem\" turbo run dev --filter=@repo/home --filter=@repo/passport --filter=@repo/storybook",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "dev:stories": "pnpm --filter @repo/storybook dev:stories",
    "dev:docs": "pnpm --filter @repo/docs dev"
  },
  "devDependencies": {
    "turbo": "^2.10.6",
    "typescript": "~5.9.3"
  }
}
