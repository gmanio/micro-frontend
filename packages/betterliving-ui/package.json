{
  "name": "@dndproperty/betterliving-ui",
  "version": "0.0.2",
  "description": "Better Living UI components",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-styles.mjs",
    "clean": "rm -rf dist",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@dnd-kit/abstract": "^0.5.0",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@fontsource-variable/inter": "5.2.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.24.0",
    "shadcn": "4.13.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8"
  },
  "exports": {
    "./package.json": "./package.json",
    "./globals.css": "./dist/styles/globals.css",
    "./lib/dnd": {
      "types": "./dist/lib/dnd/index.d.ts",
      "import": "./dist/lib/dnd/index.js",
      "require": "./dist/lib/dnd/index.js",
      "default": "./dist/lib/dnd/index.js"
    },
    "./lib/utils": {
      "types": "./dist/lib/utils.d.ts",
      "import": "./dist/lib/utils.js",
      "require": "./dist/lib/utils.js",
      "default": "./dist/lib/utils.js"
    },
    "./components/UnitCard": {
      "types": "./dist/components/UnitCard/index.d.ts",
      "import": "./dist/components/UnitCard/index.js",
      "require": "./dist/components/UnitCard/index.js",
      "default": "./dist/components/UnitCard/index.js"
    },
    "./components/DisplayUnitEditor": {
      "types": "./dist/components/DisplayUnitEditor/index.d.ts",
      "import": "./dist/components/DisplayUnitEditor/index.js",
      "require": "./dist/components/DisplayUnitEditor/index.js",
      "default": "./dist/components/DisplayUnitEditor/index.js"
    },
    "./components/badge": {
      "types": "./dist/components/badge.d.ts",
      "import": "./dist/components/badge.js",
      "require": "./dist/components/badge.js",
      "default": "./dist/components/badge.js"
    },
    "./components/button": {
      "types": "./dist/components/button.d.ts",
      "import": "./dist/components/button.js",
      "require": "./dist/components/button.js",
      "default": "./dist/components/button.js"
    },
    "./components/card": {
      "types": "./dist/components/card.d.ts",
      "import": "./dist/components/card.js",
      "require": "./dist/components/card.js",
      "default": "./dist/components/card.js"
    },
    "./components/input": {
      "types": "./dist/components/input.d.ts",
      "import": "./dist/components/input.js",
      "require": "./dist/components/input.js",
      "default": "./dist/components/input.js"
    },
    "./components/label": {
      "types": "./dist/components/label.d.ts",
      "import": "./dist/components/label.js",
      "require": "./dist/components/label.js",
      "default": "./dist/components/label.js"
    },
    "./components/skeleton": {
      "types": "./dist/components/skeleton.d.ts",
      "import": "./dist/components/skeleton.js",
      "require": "./dist/components/skeleton.js",
      "default": "./dist/components/skeleton.js"
    },
    "./types/display-unit-list": {
      "types": "./dist/types/display-unit-list.d.ts",
      "import": "./dist/types/display-unit-list.js",
      "require": "./dist/types/display-unit-list.js",
      "default": "./dist/types/display-unit-list.js"
    }
  },
  "typesVersions": {
    "*": {
      "lib/dnd": [
        "./dist/lib/dnd/index.d.ts"
      ],
      "lib/utils": [
        "./dist/lib/utils.d.ts"
      ],
      "components/UnitCard": [
        "./dist/components/UnitCard/index.d.ts"
      ],
      "components/DisplayUnitEditor": [
        "./dist/components/DisplayUnitEditor/index.d.ts"
      ],
      "components/badge": [
        "./dist/components/badge.d.ts"
      ],
      "components/button": [
        "./dist/components/button.d.ts"
      ],
      "components/card": [
        "./dist/components/card.d.ts"
      ],
      "components/input": [
        "./dist/components/input.d.ts"
      ],
      "components/label": [
        "./dist/components/label.d.ts"
      ],
      "components/skeleton": [
        "./dist/components/skeleton.d.ts"
      ],
      "types/display-unit-list": [
        "./dist/types/display-unit-list.d.ts"
      ]
    }
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  }
}
